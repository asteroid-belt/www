---
import Layout from '../../../../../layouts/Layout.astro'
import BlogCard from '../../../../../components/blog/BlogCard.astro'
import BlogGrid from '../../../../../components/blog/BlogGrid.astro'
import Pagination from '../../../../../components/blog/Pagination.astro'
import { getPublishedPosts, filterByTag, paginate, getAllTags } from '../../../../../lib/blog'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  const tags = getAllTags(posts)
  const paths: { params: { tag: string; page: string } }[] = []

  for (const tag of tags) {
    const filtered = filterByTag(posts, tag)
    const totalPages = Math.max(1, Math.ceil(filtered.length / 12))
    for (let i = 2; i <= totalPages; i++) {
      paths.push({ params: { tag, page: String(i) } })
    }
  }

  return paths
}

const { tag, page: pageParam } = Astro.params
const pageNum = parseInt(pageParam!, 10)
if (isNaN(pageNum) || pageNum < 2) return Astro.redirect('/404')

const posts = await getPublishedPosts()
const filtered = filterByTag(posts, tag!)
const page = paginate(filtered, pageNum)
if (!page) return Astro.redirect('/404')
---

<Layout title={`Blog — #${tag} — Page ${pageNum}`} description={`Posts tagged with ${tag}`}>
  <div class="mx-auto max-w-6xl px-4 pt-24 pb-12 text-left">
    <h1 class="mb-2 text-4xl font-bold text-white">Blog</h1>
    <p class="mb-8 text-white/50">
      Showing posts tagged: <span class="text-white/70">#{tag}</span>
    </p>
    <BlogGrid>
      {
        page.posts.map((post) => (
          <BlogCard
            title={post.data.title}
            slug={post.id.replace(/\.md$/, '')}
            description={post.data.description}
            publishedAt={post.data.publishedAt}
            category={post.data.category}
            heroImage={post.data.heroImage}
          />
        ))
      }
    </BlogGrid>
    <Pagination currentPage={pageNum} totalPages={page.totalPages} basePath={`/blog/tag/${tag}`} />
  </div>
</Layout>
