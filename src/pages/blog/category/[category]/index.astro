---
import Layout from '../../../../layouts/Layout.astro'
import BlogCard from '../../../../components/blog/BlogCard.astro'
import BlogGrid from '../../../../components/blog/BlogGrid.astro'
import CategoryFilter from '../../../../components/blog/CategoryFilter.astro'
import Pagination from '../../../../components/blog/Pagination.astro'
import { getPublishedPosts, filterByCategory, paginate, CATEGORIES } from '../../../../lib/blog'

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category } }))
}

const { category } = Astro.params
const posts = await getPublishedPosts()
const filtered = filterByCategory(posts, category!)
const page = paginate(filtered, 1)
---

<Layout title={`Blog — ${category}`} description={`${category} posts from Asteroid Belt`}>
  <div class="mx-auto max-w-6xl px-4 pt-24 pb-12 text-left">
    <h1 class="mb-8 text-4xl font-bold text-white">Blog</h1>
    <CategoryFilter currentCategory={category} />
    {
      page && page.posts.length > 0 ? (
        <>
          <BlogGrid>
            {page.posts.map((post) => (
              <BlogCard
                title={post.data.title}
                slug={post.id.replace(/\.md$/, '')}
                description={post.data.description}
                publishedAt={post.data.publishedAt}
                category={post.data.category}
                heroImage={post.data.heroImage}
              />
            ))}
          </BlogGrid>
          <Pagination
            currentPage={1}
            totalPages={page.totalPages}
            basePath={`/blog/category/${category}`}
          />
        </>
      ) : (
        <div class="py-16 text-center">
          <p class="mb-4 text-lg text-white/50">No posts in this category yet.</p>
          <a href="/blog" class="text-blue-400 underline">
            &larr; Back to all posts
          </a>
        </div>
      )
    }
  </div>
</Layout>
