---
interface Props {
  title: string
  publishedAt: Date
  category: string
  author: string
  authorAvatar?: string
  heroImage?: string
}

const { title, publishedAt, category, author, authorAvatar, heroImage } = Astro.props
const formattedDate = publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

{
  heroImage && (
    <div class="mb-8 aspect-[21/9] w-full overflow-hidden">
      <img src={heroImage} alt="" class="h-full w-full object-cover" />
    </div>
  )
}
<div class="mx-auto max-w-3xl px-4">
  <div class="mb-4 flex items-center gap-2">
    <span class="rounded-full bg-white/10 px-3 py-1 text-sm text-white/70 capitalize"
      >{category}</span
    >
    <span class="text-sm text-white/50">{formattedDate}</span>
  </div>
  <h1 class="mb-6 text-4xl font-bold text-white">{title}</h1>
  <div class="mb-8 flex items-center gap-3 border-b border-white/10 pb-8">
    {
      authorAvatar ? (
        <img src={authorAvatar} alt={author} class="h-10 w-10 rounded-full" />
      ) : (
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-sm text-white/50">
          {author.charAt(0)}
        </div>
      )
    }
    <span class="text-white/70">{author}</span>
  </div>
</div>
