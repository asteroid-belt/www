---
interface Props {
  title: string
  slug: string
  description: string
  publishedAt: Date
  category: string
  heroImage?: string
}

const { title, slug, description, publishedAt, category, heroImage } = Astro.props
const formattedDate = publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
})
---

<a
  href={`/blog/${slug}`}
  class="group block overflow-hidden rounded-lg border border-white/10 bg-white/5 transition-colors hover:border-white/20 hover:bg-white/10"
>
  {
    heroImage ? (
      <div class="aspect-video w-full overflow-hidden">
        <img
          src={heroImage}
          alt=""
          class="h-full w-full object-cover transition-transform group-hover:scale-105"
        />
      </div>
    ) : (
      <div class="flex aspect-video w-full items-center justify-center bg-[#252126]">
        <span class="text-sm text-white/20">No image</span>
      </div>
    )
  }
  <div class="p-4">
    <div class="mb-2 flex items-center gap-2">
      <span class="rounded-full bg-white/10 px-2 py-0.5 text-xs text-white/70 capitalize"
        >{category}</span
      >
      <span class="text-xs text-white/50">{formattedDate}</span>
    </div>
    <h3 class="mb-1 text-lg font-semibold text-white group-hover:text-white/90">{title}</h3>
    <p class="line-clamp-2 text-sm text-white/60">{description}</p>
  </div>
</a>
